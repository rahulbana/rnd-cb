# --- Remote MCP server configuration ---
# Bind address / port for the streamable-HTTP transport.
MCP_HOST=0.0.0.0
MCP_PORT=8100

# TMDB credentials. Provide EITHER a v4 read access token (preferred) OR a v3 API key.
# Get one for free at https://www.themoviedb.org/settings/api
MCP_TMDB_READ_ACCESS_TOKEN=
MCP_TMDB_API_KEY=
