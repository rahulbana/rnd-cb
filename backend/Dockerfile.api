# syntax=docker/dockerfile:1
# Multi-stage production image for the API.
#
#   builder  -- installs deps into a virtualenv (fat, cached, throwaway)
#   runtime  -- slim, non-root, copies only the venv + app source
#
# The runtime stage runs Gunicorn managing Uvicorn workers behind Cloud Run /
# the compose reverse proxy, with a container HEALTHCHECK on the liveness probe.

# ---------- builder ----------
FROM python:3.12-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

# Build toolchain for wheels that need compiling (removed from the runtime image).
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

# Self-contained virtualenv so the runtime stage copies one directory.
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install deps first for layer caching; `ml` (local embedder + vector stores),
# `prod` (Gunicorn), and `gcp` (Secret Manager + GCS) go into the API image.
COPY pyproject.toml ./
COPY app ./app
RUN pip install --upgrade pip && pip install ".[ml,prod,gcp]"

# ---------- runtime ----------
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    PORT=8080

# Runtime-only system deps: tesseract for the OCR path, curl for the healthcheck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 appuser

WORKDIR /app

# Copy the pre-built venv and the application source.
COPY --from=builder /opt/venv /opt/venv
COPY --chown=appuser:appuser . .

# Writable object-storage dir (local_disk fallback) owned by the app user.
RUN mkdir -p /data/objects && chown -R appuser:appuser /data
USER appuser

EXPOSE 8080

# Liveness probe: the process is up (no datastore access).
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -fsS "http://localhost:${PORT}/api/v1/health" || exit 1

# Migrations then serve. Gunicorn manages Uvicorn workers; WEB_CONCURRENCY
# (set by Cloud Run / compose) tunes the worker count.
CMD ["sh", "-c", "alembic upgrade head && exec gunicorn app.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers ${WEB_CONCURRENCY:-2} \
    --bind 0.0.0.0:${PORT} \
    --timeout ${GUNICORN_TIMEOUT:-120} \
    --graceful-timeout 30 \
    --access-logfile - --error-logfile -"]
