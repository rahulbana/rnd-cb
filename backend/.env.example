# Copy to .env and fill in. Loaded by your shell / process manager.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides
OPENAI_MODEL=gpt-4o-mini
ALLOWED_ORIGINS=*
MAX_UPLOAD_BYTES=15728640
MAX_SOURCE_CHARS=48000

# Question generation: coverage depth (standard | thorough | exhaustive),
# per-type ceiling, and concurrency for the per-type LLM calls.
DEFAULT_COVERAGE=thorough
MAX_QUESTIONS_PER_TYPE=40
GENERATION_WORKERS=6

# Detailed notes: sub-topics expanded and how many to illustrate with images.
NOTES_MAX_SECTIONS=14
NOTES_MAX_IMAGES=6
# Reference images in notes (DuckDuckGo image search, no key). Set off to disable.
ENABLE_IMAGE_SEARCH=true

# OCR (scanned PDFs / image uploads) — runs locally with Tesseract.
# Requires the tesseract binary: apt-get install tesseract-ocr
OCR_LANG=eng
MAX_OCR_PAGES=20
OCR_DPI=300

# Online reference research. Set ENABLE_WEB_SEARCH=false to turn it off.
# SEARCH_PROVIDER: "duckduckgo" (no key) or "tavily" (needs TAVILY_API_KEY).
ENABLE_WEB_SEARCH=true
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
RESEARCH_MAX_RESULTS=6
RESEARCH_MAX_SOURCES=8
RESEARCH_MAX_CHARS=6000
