# Copy to .env and adjust. All variables are optional; defaults shown.

# --- LLM (default: OpenAI, fallback: Ollama) ---
RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=gpt-4o-mini
RAG_OPENAI_API_KEY=sk-...            # required when provider=openai
# RAG_OPENAI_BASE_URL=               # for Azure / compatible gateways

# To run fully local instead:
# RAG_LLM_PROVIDER=ollama
# RAG_OLLAMA_MODEL=llama3.1
# RAG_OLLAMA_BASE_URL=http://localhost:11434

# --- Agent / tools ---
RAG_AGENT_ENABLED=true               # agentic mode: LLM chooses tools (vs plain RAG)
RAG_AGENT_MAX_STEPS=6
RAG_TOOLS_ENABLED=search_documents,get_current_time,calculator,web_search
RAG_WEB_SEARCH_PROVIDER=duckduckgo   # duckduckgo (keyless) | tavily | none
RAG_WEB_SEARCH_RESULTS=5
# RAG_TAVILY_API_KEY=tvly-...        # better web results when set (provider=tavily)

# --- Retrieval / reranking ---
RAG_RETRIEVAL_STRATEGY=hybrid        # simple | hybrid
RAG_RERANK_ENABLED=true
RAG_RERANK_MODELS=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RETRIEVAL_TOP_K=20
RAG_FINAL_TOP_K=5

# --- Embeddings ---
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking ---
RAG_CHUNK_STRATEGY=recursive         # recursive | by_element | semantic
RAG_CHUNK_SIZE_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=64

# --- Parsing ---
RAG_PDF_BACKEND=pymupdf              # pymupdf | pdfplumber | unstructured | docling
RAG_PDF_OCR_FALLBACK=true            # set false for digital PDFs to skip slow OCR
RAG_PDF_OCR_DPI=200                  # lower (120-150) = faster OCR, less accurate
RAG_OCR_LANGUAGE=eng

# --- Storage ---
RAG_CHROMA_PERSIST_DIR=./data/chroma
RAG_UPLOAD_DIR=./data/uploads

# --- Database (chat history) ---
RAG_DATABASE_URL=sqlite:///./data/app.db
# Postgres (production):
# RAG_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/docchat

# --- CORS (frontend dev server) ---
RAG_CORS_ORIGINS=["http://localhost:5173"]
