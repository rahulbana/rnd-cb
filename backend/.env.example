# Copy to .env and fill in. Loaded by your shell / process manager.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides
OPENAI_MODEL=gpt-4o-mini
ALLOWED_ORIGINS=*
MAX_UPLOAD_BYTES=15728640
MAX_SOURCE_CHARS=48000

# OCR (scanned PDFs / image uploads) — runs locally with Tesseract.
# Requires the tesseract binary: apt-get install tesseract-ocr
OCR_LANG=eng
MAX_OCR_PAGES=20
OCR_DPI=300
