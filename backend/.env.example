# Copy to .env and fill in. Without a key the agent uses a built-in
# deterministic analyst so the app still works end-to-end.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an Azure/OpenAI-compatible gateway.
# OPENAI_BASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
