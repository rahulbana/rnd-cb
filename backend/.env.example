# Database (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/contentforge

# OpenAI — required for real generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_RESEARCH_MODEL=gpt-4o-mini

# Deep web search (optional but recommended for real, citable sources)
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=8

# CORS — comma separated origins, or * for all
CORS_ORIGINS=*
