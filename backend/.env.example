# -----------------------------------------------------------------------------
# Diet Planner — backend configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# -----------------------------------------------------------------------------

# OpenAI ---------------------------------------------------------------------
# If OPENAI_API_KEY is empty the app still runs end-to-end using a deterministic
# fallback meal planner (clearly flagged in the response). Set a real key to use
# the LLM-powered meal planner and safety-review summaries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=3

# Application ----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# SQLite database URL (SQLAlchemy format).
DATABASE_URL=sqlite:///./diet_planner.db

# Comma-separated list of allowed CORS origins for the React frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
