# --- App ---
APP_NAME=rag-platform
ENV=dev
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=true

# --- Security (single-tenant today, multi-tenant-shaped) ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Datastores ---
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- Provider selection: swap an implementation by changing one value ---
LLM_PROVIDER=fake                  # fake  (later: ollama | openai | anthropic | gemini)
RERANKER_PROVIDER=fake             # fake  (later: cross_encoder | cohere | llm)
# Phase 5 -- hybrid retrieval (dense + BM25 fused with Reciprocal Rank Fusion)
RETRIEVER_STRATEGY=hybrid          # hybrid | dense | sparse | fake
RRF_K=60                           # Reciprocal Rank Fusion damping constant
# Phase 4 -- async ingestion. celery (broker+worker) | inline (in-process, no
# Redis; handy for local dev) | fake (records only).
TASK_QUEUE_PROVIDER=celery

# Phase 2 -- real multi-format parsing + storage:
PARSER_STRATEGY=router             # router | plain | pymupdf | docx | tesseract_image | docling | unstructured | fake
STORAGE_PROVIDER=local_disk        # local_disk | fake  (later: gcs | s3)
# Fallback chain for PARSER_STRATEGY=router (priority order). Lightweight,
# fully-local parsers first; Docling/Unstructured (heavy) as fallbacks.
PARSER_PRIORITY=plain,pymupdf,docx,tesseract_image,unstructured,docling

# Phase 3 -- chunking, embedding, vector storage:
CHUNKER_STRATEGY=structure_aware   # structure_aware | fixed_size | recursive | fake
EMBEDDER_PROVIDER=sentence_transformers   # sentence_transformers | openai | fake | fake_hash
VECTOR_STORE_PROVIDER=chroma       # chroma | pgvector | fake
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Chroma client mode: http (compose/prod) | ephemeral (in-memory) | persistent
CHROMA_MODE=http
CHROMA_PERSIST_DIR=./data/chroma

# --- Async ingestion (Phase 4) ---
INGEST_MAX_ATTEMPTS=3              # retries before a job is dead-lettered
INGEST_BACKOFF_BASE=0.5           # seconds; doubles each retry
MAX_BULK_DOCS=200                 # max entries accepted from one zip upload
INGEST_RATE_LIMIT=100             # max enqueues per window
INGEST_RATE_WINDOW_SECONDS=60

# --- Provider credentials (unused by fakes) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# COHERE_API_KEY=
# LLAMAPARSE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
