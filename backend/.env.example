# Copy to .env and fill in. Without an OpenAI key the app still works using a
# built-in deterministic resume generator (no AI rewriting).

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible endpoint (Azure, local proxy, etc.)
# OPENAI_BASE_URL=

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
