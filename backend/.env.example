# --- App ---
ENV=development
DEBUG=true

# --- CORS (frontend origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Local dev (default): SQLite, zero setup.
DATABASE_URL=sqlite+aiosqlite:///./contentwriter.db
# Production (Postgres):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/contentwriter

# --- Auth ---
# Generate a strong value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_super_secret_key_for_dev_only
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- OpenAI / LLM ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
# Max output tokens per generation. Raise for longer articles
# (gpt-4o / gpt-4o-mini support up to 16000).
LLM_MAX_TOKENS=12000

# --- Observability (Langfuse) ---
# Tracing turns on automatically when both keys are set.
# Get keys from https://cloud.langfuse.com (or your self-hosted instance).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Trace every API request as one trace (full request in / response out, with
# LLM + tool spans nested). Set false to trace only the LLM calls.
LANGFUSE_TRACE_REQUESTS=true

# --- Images (banners) ---
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1536x1024
MEDIA_DIR=./media

# --- Web research ---
# openai (built-in web search, no extra key) | tavily | none
WEB_SEARCH_PROVIDER=openai
WEB_SEARCH_MODEL=gpt-4o-mini
# TAVILY_API_KEY=          # only needed when WEB_SEARCH_PROVIDER=tavily
DEEP_RESEARCH_MAX_QUERIES=4

# --- Embeddings ---
# hash (default, no deps) | sentence_transformers | openai
EMBEDDING_PROVIDER=hash
# For the spec's model: EMBEDDING_PROVIDER=sentence_transformers and:
# EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=articles
DUPLICATE_DISTANCE_THRESHOLD=0.15
