# Copy to .env for local development. NEVER commit real secrets.

# --- OpenAI (required) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_SYNTHESIS_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.0

# --- Search ---
# Tavily is the primary provider; if omitted, the agent falls back to DuckDuckGo.
TAVILY_API_KEY=
MAX_RESULTS_PER_QUERY=5

# --- Research loop budget (bounds long-running runs) ---
MAX_ITERATIONS=4
MAX_QUERIES_PER_ITERATION=4

# --- Postgres (checkpointer / durable state) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
