# Copy this file to .env and fill in your values.

# Your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Model to use for analysis. gpt-4o-mini is fast and cheap; gpt-4o is more accurate.
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max number of texts allowed in a single batch / CSV upload.
MAX_BATCH_SIZE=200
