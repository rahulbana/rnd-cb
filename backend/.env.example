# --- App ---
APP_NAME=rag-platform
ENV=dev
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=true

# --- Security (single-tenant today, multi-tenant-shaped) ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Datastores ---
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- Provider selection: swap an implementation by changing one value ---
# Phase 1 ships fakes only. Real adapters are added in later phases.
LLM_PROVIDER=fake                  # fake  (later: ollama | openai | anthropic | gemini)
EMBEDDER_PROVIDER=fake             # fake | fake_hash  (later: sentence_transformers | openai)
VECTOR_STORE_PROVIDER=fake         # fake  (later: chroma | pgvector | pinecone)
RERANKER_PROVIDER=fake             # fake  (later: cross_encoder | cohere | llm)
RETRIEVER_STRATEGY=fake            # fake  (later: dense | sparse | hybrid)
PARSER_STRATEGY=fake               # fake  (later: docling | pymupdf | unstructured | plain)
CHUNKER_STRATEGY=fake              # fake  (later: structure_aware | fixed_size | recursive)
STORAGE_PROVIDER=fake              # fake  (later: local_disk | gcs | s3)
TASK_QUEUE_PROVIDER=fake           # fake  (later: celery | arq | rq)

# --- Provider credentials (unused by fakes) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# COHERE_API_KEY=
# LLAMAPARSE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
