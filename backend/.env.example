# --- LLM (OpenAI) ---
OPENAI_API_KEY=
# Any chat-completions capable model. Defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# --- Web search provider ---
# Supported: tavily | serpapi | mock
# If a provider key is missing, the app automatically falls back to "mock".
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Max search results pulled per book lookup.
SEARCH_MAX_RESULTS=8

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma separated list of allowed CORS origins for the React frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
