# Settings are read case-insensitively, so OPENAI_API_KEY and openai_api_key
# both work. Defaults shown below.

# ---- LLM ----
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# ---- Web search ----
# If TAVILY_API_KEY is set and SEARCH_PROVIDER=auto, Tavily is used.
# Otherwise the app falls back to DuckDuckGo, which needs no API key.
SEARCH_PROVIDER=auto          # auto | tavily | duckduckgo
TAVILY_API_KEY=

# ---- Agent behaviour ----
NUM_SUBQUERIES=4
RESULTS_PER_QUERY=4

# ---- Report length / depth ----
REPORT_MAX_TOKENS=4000
REPORT_TARGET_WORDS=800
SOURCE_CONTENT_CHARS=2000

# ---- API / server ----
API_PREFIX=/api
FRONTEND_ORIGIN=*             # use the Vite origin in production, e.g. http://localhost:5173

# ---- Logging ----
LOG_LEVEL=INFO
LOG_TO_FILE=false            # set true to also write logs to a rotating file
LOG_FILE=logs/app.log       # path to the log file (created if missing)
LOG_MAX_BYTES=10485760      # rotate after this many bytes (default 10 MB)
LOG_BACKUP_COUNT=5          # number of rotated files to keep

# ---- Run history (tracing store) ----
PERSIST_RUNS=true           # store each run (query, sub-queries, steps, sources, report)
RUNS_DB_PATH=data/runs.db   # SQLite file (created if missing)
RUNS_LIST_LIMIT=100         # max runs returned by the history API

# ---- LangSmith tracing (OPTIONAL, off by default) ----
# Enabling this sends run content (incl. user queries) to LangSmith's cloud.
# Get a key at https://smith.langchain.com then uncomment:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=deep-search-agent
