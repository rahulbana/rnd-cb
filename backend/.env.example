# --- OpenAI / LLM ------------------------------------------------------------
# Your OpenAI API key. If omitted, the SDK falls back to the OPENAI_API_KEY
# environment variable.
OPENAI_API_KEY=

# Optional custom base URL (e.g. Azure OpenAI or an OpenAI-compatible gateway).
# Leave empty to use the default OpenAI endpoint.
OPENAI_BASE_URL=

# Model id.
# NOTE: reasoning models (o1, o3, gpt-5, ...) do NOT accept a custom
# `temperature` — it is ignored for them. To make the temperature control take
# effect, use a standard chat model, e.g. gpt-4o-mini, gpt-4o, or gpt-4-turbo.
MODEL=gpt-4o-mini

# Maximum tokens per assistant response.
MAX_TOKENS=4096

# --- Conversation defaults ---------------------------------------------------
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
DEFAULT_TEMPERATURE=1.0

# --- Authentication (HTTP Basic) --------------------------------------------
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./chatbot.db

# --- Server / CORS -----------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
