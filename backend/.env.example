# Copy this file to .env and fill in your values.

# Required: your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: model to use for all agents (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: comma-separated list of allowed CORS origins for the frontend
# Defaults to a permissive localhost set for development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: web research to ground quiz questions in board materials
# (CBSE/ICSE sites, previous-year papers, teacher notes).
# Set to false to disable. Defaults to true (uses free DuckDuckGo search).
WEB_RESEARCH=true

# Optional: set a Tavily API key for higher-quality research (falls back to
# DuckDuckGo when unset or when Tavily returns nothing).
TAVILY_API_KEY=

# Optional: number of results fetched per search query (default 4).
RESEARCH_MAX_RESULTS=4

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
LOG_LEVEL=INFO
