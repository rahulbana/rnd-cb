# --- Anthropic / LLM ---------------------------------------------------------
# Your Anthropic API key. If omitted, the SDK falls back to an `ant auth login`
# profile or the ANTHROPIC_API_KEY environment variable.
ANTHROPIC_API_KEY=

# Model id. Default is the current frontier model.
# NOTE: frontier models (claude-opus-5, claude-sonnet-5, claude-opus-4-8, ...)
# do NOT support the `temperature` parameter — it is ignored for them. To make
# the temperature control take effect, use a model that supports sampling,
# e.g. claude-haiku-4-5 or claude-sonnet-4-6.
MODEL=claude-opus-5

# Effort controls thinking depth / token spend: low | medium | high | xhigh | max
EFFORT=medium

# Maximum tokens per assistant response.
MAX_TOKENS=4096

# --- Conversation defaults ---------------------------------------------------
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
DEFAULT_TEMPERATURE=1.0

# --- Authentication (HTTP Basic) --------------------------------------------
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./chatbot.db

# --- Server / CORS -----------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
