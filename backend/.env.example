# Copy this file to .env and fill in your values.

# Your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Model used for SQL generation and explanation.
OPENAI_MODEL=gpt-4o-mini

# Optional: override the OpenAI base URL (e.g. for a proxy or compatible API).
# OPENAI_BASE_URL=

# SQL dialect used for validation/formatting (sqlglot dialect name).
# Examples: postgres, mysql, sqlite, snowflake, bigquery, tsql
SQL_DIALECT=postgres

# Where the query-history SQLite database lives (relative to backend/).
HISTORY_DB_PATH=history.db

# CORS origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
