# ---- Required ----
OPENAI_API_KEY=sk-...

# ---- Optional ----
# Chat model to use for planning + synthesis
OPENAI_MODEL=gpt-4o-mini

# If set, Tavily is used for web search (higher quality). Otherwise the app
# falls back to DuckDuckGo, which needs no API key.
TAVILY_API_KEY=
# auto | tavily | duckduckgo
SEARCH_PROVIDER=auto

# Number of sub-queries the planner generates, and results fetched per query.
NUM_SUBQUERIES=4
RESULTS_PER_QUERY=4

# Length / depth of the synthesized report.
# Max output tokens for the report (raise for longer answers).
REPORT_MAX_TOKENS=4000
# Rough target length, in words, the model aims for.
REPORT_TARGET_WORDS=800
# Max characters of each source's content fed into the synthesis prompt.
SOURCE_CONTENT_CHARS=2000

# CORS: the Vite dev server origin (use * to allow all during development)
FRONTEND_ORIGIN=*
