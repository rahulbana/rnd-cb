# --- Backend (FastAPI + LangGraph) configuration ---
# OpenAI credentials and model.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# Remote MCP server endpoint (streamable-HTTP). Matches the MCP server above.
MCP_SERVER_URL=http://localhost:8100/mcp
MCP_TRANSPORT=streamable_http

# Comma-separated origins allowed to call the API (the React dev server).
# Note: list values are JSON-encoded for pydantic-settings.
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
