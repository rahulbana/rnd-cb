# Copy this file to `.env` (in this backend/ directory) and fill in your values.

# Required: your OpenAI API key.
OPENAI_API_KEY=sk-...

# Optional: default model (can also be changed in the app UI).
OPENAI_MODEL=gpt-4o

# Optional: Postgres connection string for persistent chat history.
# If omitted, the backend runs with in-memory history (lost on restart).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rnd_cb

# Optional: default project directory the agent operates in.
# Defaults to the backend's working directory; changeable in the UI.
# PROJECT_DIR=/absolute/path/to/your/project

# Optional: default approval mode for file writes / shell commands.
# "ask" (default) prompts for approval; "auto" runs without prompting.
AGENT_PERMISSION_MODE=ask

# Optional: Python interpreter used to create a new project's virtual
# environment (.venv) from the "New project" dialog. Defaults to python3.12.
VENV_PYTHON=python3.12
