# Copy to .env and adjust for your environment.
APP_NAME="RBAC Dashboard Platform"

# SQLite (async). Use an absolute path or a file relative to the backend dir.
DATABASE_URL="sqlite+aiosqlite:///./app.db"

# JWT — generate a strong secret for production, e.g. `openssl rand -hex 32`
JWT_SECRET="change-me-please-use-a-long-random-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma/JSON list of allowed frontend origins
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Bootstrap superadmin created on first startup (change the password!)
FIRST_SUPERADMIN_EMAIL="admin@example.com"
FIRST_SUPERADMIN_PASSWORD="Admin@12345"
FIRST_SUPERADMIN_NAME="Super Admin"
