# Zero-dependency LOCAL profile: run the whole pipeline with no external
# services (no Postgres, Redis, Chroma, Ollama, or model downloads).
#
#   cd backend
#   cp .env.local .env
#   alembic upgrade head
#   uvicorn app.main:app --reload --port 8080
#
# Everything runs on fakes + SQLite + an in-process task queue, so uploads,
# ingestion, retrieval, and chat all work end-to-end with deterministic output.
# Swap any value below for a real provider once its dependency is available.

# --- App ---
APP_NAME=rag-platform
ENV=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
# Allow the Vite dev server (frontend) to call this API cross-origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Security ---
SECRET_KEY=local-dev-secret-key-at-least-32-bytes-long!
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Datastores: SQLite file, no server needed ---
DATABASE_URL=sqlite:///./local.db

# --- Providers: all fakes (no network, no model downloads, no GPU) ---
LLM_PROVIDER=fake
EMBEDDER_PROVIDER=fake
VECTOR_STORE_PROVIDER=fake
RERANKER_PROVIDER=fake
RETRIEVER_STRATEGY=hybrid
PARSER_STRATEGY=router
CHUNKER_STRATEGY=structure_aware

# --- Storage: local disk (no cloud) ---
STORAGE_PROVIDER=local_disk
LOCAL_STORAGE_DIR=./data/objects

# --- Async ingestion: run jobs in-process (no Celery/Redis worker) ---
TASK_QUEUE_PROVIDER=inline

# --- Observability & secrets: local defaults ---
TRACER_PROVIDER=noop
EVAL_HARNESS=heuristic
SECRET_PROVIDER=env
