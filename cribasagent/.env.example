# Copy to .env and fill in. cribasagent loads this automatically.

# Required: your OpenAI API key.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown).
CRIBAS_MODEL=gpt-4o-mini
CRIBAS_TEMPERATURE=0.2
CRIBAS_LOOKBACK_HOURS=24
CRIBAS_MAX_ARTICLES=120
CRIBAS_BATCH_SIZE=12
CRIBAS_REQUEST_TIMEOUT=20
CRIBAS_OUTPUT_DIR=output
CRIBAS_RUN_AT=10:00
# Keep items whose feed has no parseable date (1=yes). Prevents an odd date
# format from zeroing a run. Set to 0 to enforce a strict time window.
CRIBAS_KEEP_UNDATED=1
# Disable TLS certificate verification (1=yes). Only set this if you are behind
# a corporate proxy/antivirus that intercepts TLS (self-signed cert errors).
CRIBAS_INSECURE_SSL=0
