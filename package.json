{
  "name": "ai-text-summarizer",
  "version": "1.0.0",
  "description": "An AI-powered text summarizer built on the OpenAI API. Streaming summaries, multiple lengths/styles/formats, key-point extraction, structured executive reports, and context-window-aware handling of very long documents.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "openai",
    "gpt",
    "summarizer",
    "llm",
    "streaming"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "js-tiktoken": "^1.0.21",
    "openai": "^7.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
