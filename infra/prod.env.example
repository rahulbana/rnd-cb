# Copy to infra/prod.env (git-ignored) and fill in real values before running
# the production compose stack. Never commit the filled-in file.
#
#   docker compose -f infra/docker-compose.prod.yml --env-file infra/prod.env up --build

# Required secrets (no defaults -- the compose file errors if unset).
POSTGRES_PASSWORD=change-me-strong-password
SECRET_KEY=change-me-a-long-random-string-at-least-32-bytes

# Secret backend: env (read these vars) | gcp_secret_manager (production GCP).
SECRET_PROVIDER=env

# Process concurrency (tune to the host / Cloud Run instance size).
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2

# LLM + observability (optional).
LLM_PROVIDER=ollama
TRACER_PROVIDER=noop
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
