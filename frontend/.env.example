# Optional: override the API base URL. By default the app calls "/api",
# which the Vite dev server proxies to the backend (see vite.config.js).
# Set this only if you serve the API from a different origin.
# VITE_API_BASE=http://localhost:8000/api

# Optional: change where the dev proxy forwards /api requests.
# VITE_API_TARGET=http://localhost:8000
