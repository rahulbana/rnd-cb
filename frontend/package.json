{
  "name": "rnd-cb-agent",
  "version": "0.1.0",
  "description": "Desktop AI coding agent (Electron + React + TypeScript frontend, FastAPI + Python backend) powered by OpenAI, with Postgres-backed history.",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "backend:install": "pip install -r ../backend/requirements.txt",
    "backend": "cd ../backend && python3 -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "package": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
