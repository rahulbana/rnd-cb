# Copy to .env and fill in your key (or run `ant auth login` and leave this unset).
# The Anthropic SDK resolves credentials from ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN,
# or an `ant auth login` profile automatically.
ANTHROPIC_API_KEY=sk-ant-...

# Port the web server listens on.
PORT=3000

# Model used for summarization. Defaults to claude-opus-5.
# Cheaper options: claude-sonnet-5, claude-haiku-4-5
SUMMARIZER_MODEL=claude-opus-5

# When the input exceeds this many tokens, the summarizer switches from a single
# pass to a chunked map-reduce pass (see src/summarizer.ts). Lower it to see the
# context-window handling kick in on smaller documents.
CHUNK_THRESHOLD_TOKENS=180000
