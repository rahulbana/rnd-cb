# Copy this file to .env and fill in your values.

# Required: your OpenAI API key.
OPENAI_API_KEY=sk-your-key-here

# Optional: model to use (default: gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Optional: custom OpenAI-compatible base URL (leave blank for the default).
# OPENAI_BASE_URL=

# Optional: max number of translations kept in the in-memory history.
HISTORY_LIMIT=200

# Optional: comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
