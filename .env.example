# ── LLM ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model used for cheap/frequent nodes (planning, reflection, extraction)
FAST_MODEL=claude-haiku-4-5-20251001
# Model used for final synthesis and factuality judging
SMART_MODEL=claude-sonnet-5

# ── Search backends (enable any subset; the aggregator uses whatever has a key)
TAVILY_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=
# arxiv needs no key

# ── Persistence (LangGraph checkpointer) ────────────────────────────────────
# If unset, an in-memory checkpointer is used (no crash recovery).
DATABASE_URL=postgresql://research:research@localhost:5432/research

# ── Observability (Langfuse) ────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Budget / safety caps ────────────────────────────────────────────────────
MAX_ITERATIONS=5
MAX_USD_COST=2.50
MAX_SEARCHES_PER_ITERATION=6
MAX_SOURCES=40
