# ===========================================================================
# Agentic AI (ecommerce assistant) — environment configuration
# Copy this file to `.env` and fill in the values you need.
# ===========================================================================

# ---- OpenAI (required) ----------------------------------------------------
OPENAI_API_KEY=sk-...
# Any tool-calling capable chat model. gpt-4o is a safe default.
OPENAI_MODEL=gpt-4o
# Optional: point at an OpenAI-compatible gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Database (SQLite for now; swappable to Postgres later) ---------------
# Path to the SQLite database file. Created by scripts/init_db.py.
DB_PATH=data/ecommerce.db
# Set to "true" to let the agent run INSERT/UPDATE/DELETE. Default read-only.
DB_ALLOW_WRITES=false

# ---- Web search (Tavily) --------------------------------------------------
# Get a key at https://tavily.com. Without it the search tools return a
# clear "not configured" message instead of crashing.
TAVILY_API_KEY=tvly-...

# ---- File system tool -----------------------------------------------------
# The agent can only read/write inside this sandbox directory.
WORKSPACE_DIR=workspace

# ---- Email tool: sending (SMTP) -------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=you@example.com
# When "true", emails are printed to the console instead of actually sent.
EMAIL_DRY_RUN=true

# ---- Email tool: reading (IMAP, read-only) --------------------------------
# Enables search_emails / read_email. Credentials default to the SMTP ones
# above (same mailbox); override only if your read login differs.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# IMAP_USER=you@example.com
# IMAP_PASSWORD=your-app-password

# ---- Shell tool (DANGEROUS — disabled by default) -------------------------
# Lets the agent run arbitrary shell commands with your privileges. Only turn
# this on in an environment you trust.
SHELL_TOOL_ENABLED=false
# Seconds before a command is killed.
SHELL_TIMEOUT=30
# Working directory for commands. Defaults to WORKSPACE_DIR if unset.
# SHELL_WORKDIR=.

# ---- Agent behaviour ------------------------------------------------------
# Max tool-calling iterations per user turn (guards against loops).
AGENT_MAX_STEPS=12
