# ============================================================
# AutoDev configuration. Copy to `.env` and edit.
# All variables are prefixed with AUTODEV_
# ============================================================

# ---- LLM provider: "openai" or "ollama" ----
AUTODEV_LLM_PROVIDER=openai

# ---- OpenAI ----
AUTODEV_OPENAI_API_KEY=sk-your-key-here
AUTODEV_OPENAI_BASE_URL=https://api.openai.com/v1
AUTODEV_OPENAI_MODEL=gpt-4o-mini

# ---- Ollama (local) ----
AUTODEV_OLLAMA_BASE_URL=http://localhost:11434
AUTODEV_OLLAMA_MODEL=llama3.1

# ---- Generation controls ----
AUTODEV_TEMPERATURE=0.2
AUTODEV_MAX_FIX_ITERATIONS=4
AUTODEV_REQUEST_TIMEOUT=600

# ---- Sandbox ----
# Root directory where each project's isolated workspace is created.
AUTODEV_WORKSPACE_ROOT=./workspaces
# Max seconds any single shell command may run inside the sandbox.
AUTODEV_COMMAND_TIMEOUT=300
# Whether to create a per-project Python venv automatically for python projects.
AUTODEV_AUTO_VENV=true

# ---- Persistence ----
AUTODEV_DATABASE_URL=sqlite:///./autodev.db

# ---- Optional long-term vector memory (ChromaDB + sentence-transformers) ----
AUTODEV_MEMORY_ENABLED=false
AUTODEV_MEMORY_DIR=./memory_store
AUTODEV_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Server ----
AUTODEV_HOST=127.0.0.1
AUTODEV_PORT=8000
