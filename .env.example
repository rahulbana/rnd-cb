# ---- OpenAI (LLM) ----
OPENAI_API_KEY=sk-your-openai-key
# Any chat-completions capable model, e.g. gpt-4o, gpt-4o-mini, gpt-4.1
OPENAI_MODEL=gpt-4o

# ---- Remote MCP server (SQLite client directory) ----
# Where the agent connects (streamable-HTTP endpoint, note the /mcp path)
MCP_SERVER_URL=http://localhost:8000/mcp
# Where the MCP server itself binds
MCP_HOST=0.0.0.0
MCP_PORT=8000
# SQLite database file for client records
MCP_DB_PATH=./data/clients.db

# ---- Web search tools ----
# Tavily is optional; if unset the Tavily tool reports that it is unconfigured.
TAVILY_API_KEY=
# DuckDuckGo needs no key.

# ---- Custom tools ----
# Free FX rates endpoint (no key required by default).
FX_API_BASE=https://open.er-api.com/v6/latest
