# ---------------------------------------------------------------------------
# product-intel environment variables (example)
#
# Copy to `.env` and fill in as needed:   cp .env.example .env
# `.env` is git-ignored and must never be committed.
#
# NONE of these are required for the default offline pipeline:
#   product-intel run --sample --html dashboard.html
# They only apply to the optional integrations below.
# ---------------------------------------------------------------------------

# --- Claude-backed synthesis (only for `--llm anthropic`) ------------------
# API key for the Anthropic Claude API. Required only when you pass
# `--llm anthropic`; the pipeline falls back to the offline engine otherwise.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for synthesis (default: claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Live scraping (only for `--url ... --live`) ---------------------------
# If you route scraping through a proxy / anti-bot service, put its endpoint
# here and wire it into PlaywrightScraper. Unused by default.
# SCRAPE_PROXY_URL=
