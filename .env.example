# =============================================================
#  AI Agent — configuration
#  Copy this file to `.env` and fill in the values you have.
#  Only OPENAI_API_KEY is required; everything else is optional.
# =============================================================

# ---- LLM provider: "openai" or "ollama" (can also be switched in the UI) ----
LLM_PROVIDER=openai

# OpenAI — required when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: custom OpenAI-compatible endpoint
OPENAI_BASE_URL=

# Ollama — used when LLM_PROVIDER=ollama (no API key needed; run `ollama serve`)
# Use a tool-capable model, e.g. llama3.1, qwen2.5, mistral-nemo.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ---- Optional API keys (tools fall back gracefully if unset) ----
# Calendarific — improves the "festival date" tool. Free tier: https://calendarific.com
CALENDARIFIC_API_KEY=

# NewsAPI — optional alternative source for news headlines. https://newsapi.org
# (Left blank, the news tool uses free Google News RSS instead.)
NEWSAPI_KEY=

# ---- Server / app settings ----
HOST=127.0.0.1
PORT=8765
# Directory where "save research result" writes exported files
EXPORT_DIR=exports

# ---- Logging ----
# Minimum level written to logs/agent-YYYY-MM-DD.log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Directory for date-wise log files
LOG_DIR=logs
# Delete log files older than this many days on startup (0 = keep forever)
LOG_RETENTION_DAYS=30
