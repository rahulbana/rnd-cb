# Copy this file to ".env" and fill in your keys.

# OpenAI API key — used ONLY to (1) draft search queries and
# (2) reason over the text the agent fetched from the web.
OPENAI_API_KEY=sk-...

# Tavily API key — used to search the live web and gather source text.
# Get one at https://app.tavily.com (free tier available).
TAVILY_API_KEY=tvly-...

# Optional: override the OpenAI model used for reasoning.
OPENAI_MODEL=gpt-4o
