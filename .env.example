# ML Dataset Generator Agent — environment configuration.
# Copy this file to `.env` and fill in your values:  cp .env.example .env
# `.env` is git-ignored, so your real API key is never committed.

# --- Planner ---------------------------------------------------------------
# "heuristic" (offline, no API key) or "llm".
PLANNER_BACKEND=heuristic

# LLM provider for the optional planner: openai (default), anthropic, or litellm.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# --- OpenAI ----------------------------------------------------------------
# Required when PLANNER_BACKEND=llm and LLM_PROVIDER=openai.
OPENAI_API_KEY=sk-your-key-here
# Optional: override for Azure OpenAI or an OpenAI-compatible gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Generation ------------------------------------------------------------
# Safety cap on requested rows so a runaway prompt cannot exhaust memory.
MAX_ROWS=2000000
