# ---------------------------------------------------------------------------
# Code Review Agent configuration
# Copy this file to `.env` and fill in your credentials.
# ---------------------------------------------------------------------------

# REQUIRED: your OpenAI API key.
OPENAI_API_KEY=sk-your-key-here

# Model to use (any chat-completions model that supports JSON output).
OPENAI_MODEL=gpt-4o-mini

# OPTIONAL: point at an OpenAI-compatible gateway / Azure OpenAI endpoint.
# OPENAI_BASE_URL=https://your-gateway.example.com/v1

# ---------------------------------------------------------------------------
# Tuning (all optional; sensible defaults are used if unset)
# ---------------------------------------------------------------------------
# REVIEW_TEMPERATURE=0.0
# REVIEW_MAX_TOKENS=8192
# REVIEW_TIMEOUT=90
# REVIEW_MAX_RETRIES=4
# REVIEW_CONCURRENCY=4
# REVIEW_MAX_FILE_BYTES=400000
# REVIEW_CHUNK_LINES=400

# Dependency resolution: feed definitions of called functions/methods to the
# reviewer so it can validate call sites against the callee's definition.
# REVIEW_RESOLVE_DEPS=true
# REVIEW_MAX_DEP_DEFS=12
# REVIEW_MAX_DEP_CHARS=6000
# REVIEW_MAX_INDEX_FILES=400

# Package-manifest context (requirements.txt / pyproject.toml) for the
# 'dependency' perspective.
# REVIEW_INCLUDE_MANIFESTS=true
# REVIEW_MAX_MANIFEST_CHARS=4000
