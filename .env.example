# ---------------------------------------------------------------------------
# TravelPlanner configuration. Copy to `.env` and fill in.
# The app runs fully offline with NO values set (mock LLM + estimate tools).
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Security (CHANGE IN PRODUCTION) ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma/JSON list of allowed CORS origins in production, e.g. ["https://app.example.com"]
# CORS_ORIGINS=["*"]

# --- Database ---
# SQLite (default, zero-config):
DATABASE_URL=sqlite+pysqlite:///./travelplanner.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://travel:travel@localhost:5432/travelplanner

# --- Redis (optional; caching / rate limiting) ---
# REDIS_URL=redis://localhost:6379/0

# --- OpenAI (optional; enables full AI reasoning) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o

# --- Live data ---
# Master switch. true (default): tools call keyless public APIs for real data
# (Open-Meteo geocoding + weather, Frankfurter FX) and fall back to estimates
# only if a call fails. Set false to force fully-offline estimates.
ENABLE_LIVE_DATA=true

# --- External tool APIs ---
# Geocoding, weather and currency use KEYLESS public APIs — no key needed.
#
# Amadeus (free self-service tier at https://developers.amadeus.com) — enables
# REAL flight offers instead of a distance-based estimate:
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_BASE_URL=https://test.api.amadeus.com
#
# OpenTripMap (free key at https://opentripmap.io) — enables REAL attractions
# and dining POIs feeding the activity/food agents:
# OPENTRIPMAP_API_KEY=
#
# Tavily (free tier at https://tavily.com) — enables REAL web search:
# TAVILY_API_KEY=
#
# WEATHER_API_KEY=   # reserved (Open-Meteo needs no key)
# MAPS_API_KEY=      # reserved

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
