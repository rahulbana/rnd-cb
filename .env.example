# Copy to .env and fill in. Only OPENAI_API_KEY is required.

# Required: your OpenAI API key.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown).
# Model used for planning and validation.
QPAPER_MODEL=gpt-4o
# Model used for web search (must support the web_search tool).
QPAPER_SEARCH_MODEL=gpt-4o
# Directory where papers and manifests are written.
QPAPER_OUTPUT_DIR=downloads
# HTTP timeout in seconds for the downloader.
QPAPER_HTTP_TIMEOUT=60
# Max candidates carried between stages (cost control).
QPAPER_MAX_CANDIDATES=25
