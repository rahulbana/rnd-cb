# Frontend / Electron configuration.
# Copy to `.env` at the repo root if you need to override defaults.
# (Backend/OpenAI/Postgres settings live in backend/.env — see backend/.env.example)

# Host/port where the FastAPI backend runs. Electron spawns it here and the
# renderer connects to it.
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8000

# Connect to an already-running backend instead of spawning one (useful in dev
# when you run `npm run backend` yourself). If set, Electron will NOT spawn.
# BACKEND_URL=http://127.0.0.1:8000

# Python executable used to spawn the backend (defaults to python3 / python).
# PYTHON=python3
