# Copy this file to .env and fill in your values.

# Required: your OpenAI API key.
OPENAI_API_KEY=sk-your-key-here

# Optional: which OpenAI chat model to use (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Optional: override the OpenAI base URL (useful for Azure / proxies).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: HTTP timeout (in seconds) for the tools that call external APIs.
YEAI_HTTP_TIMEOUT=20
