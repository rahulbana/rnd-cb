# Copy to .env and fill in your key.
# The OpenAI SDK reads OPENAI_API_KEY from the environment automatically.
OPENAI_API_KEY=sk-...

# Optional: point at an OpenAI-compatible endpoint (e.g. Azure OpenAI, a proxy).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Port the web server listens on.
PORT=3000

# Model used for summarization. Defaults to gpt-4o-mini.
# Higher quality: gpt-4o, gpt-4.1
SUMMARIZER_MODEL=gpt-4o-mini

# When the input exceeds this many tokens, the summarizer switches from a single
# pass to a chunked map-reduce pass (see app/summarizer.py). Lower it to see the
# context-window handling kick in on smaller documents.
CHUNK_THRESHOLD_TOKENS=100000
