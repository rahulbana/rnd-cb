# ---- Required ----
# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# ---- Optional: web research ----
# Tavily search API key (https://app.tavily.com). If unset, research is skipped.
TAVILY_API_KEY=tvly-...

# ---- Model / behaviour tuning (all optional) ----
# Main reasoning/content model
DECKFORGE_MODEL=gpt-4o
# Cheaper model for lightweight steps (outline cleanup, titles)
DECKFORGE_FAST_MODEL=gpt-4o-mini
# Sampling temperature for creative copy
DECKFORGE_TEMPERATURE=0.6
# Max web-search queries the research agent may issue
DECKFORGE_MAX_SEARCHES=4
# Default visual theme (midnight | sunset | ocean | forest | mono)
DECKFORGE_THEME=midnight
# Output directory for generated decks
DECKFORGE_OUTPUT_DIR=ppt
