# Copy this file to ".env" and fill in your keys.

# --- OpenAI (the LLM that powers every agent) ---
OPENAI_API_KEY=sk-your-openai-key-here
# Model used by all agents. gpt-4o gives the best reasoning/verification;
# gpt-4o-mini is cheaper and faster for demos.
OPENAI_MODEL_NAME=gpt-4o

# --- Tavily (the deep web search backend) ---
TAVILY_API_KEY=tvly-your-tavily-key-here
