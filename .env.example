# ---------------------------------------------------------------------------
# Code Review Agent configuration
# Copy this file to `.env` and fill in your credentials.
# ---------------------------------------------------------------------------

# REQUIRED: your OpenAI API key.
OPENAI_API_KEY=sk-your-key-here

# Model to use (any chat-completions model that supports JSON output).
OPENAI_MODEL=gpt-4o-mini

# OPTIONAL: point at an OpenAI-compatible gateway / Azure OpenAI endpoint.
# OPENAI_BASE_URL=https://your-gateway.example.com/v1

# ---------------------------------------------------------------------------
# Tuning (all optional; sensible defaults are used if unset)
# ---------------------------------------------------------------------------
# REVIEW_TEMPERATURE=0.0
# REVIEW_MAX_TOKENS=4096
# REVIEW_TIMEOUT=60
# REVIEW_MAX_RETRIES=4
# REVIEW_CONCURRENCY=4
# REVIEW_MAX_FILE_BYTES=200000
