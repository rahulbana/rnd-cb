# Copy to .env and fill in. Only OPENAI_API_KEY is required.
OPENAI_API_KEY=sk-your-key-here

# Optional: point at an OpenAI-compatible gateway (Azure OpenAI, LiteLLM, etc.)
# OPENAI_BASE_URL=https://your-gateway/v1

# Optional: enables the web_search tool (https://tavily.com). Other tools work
# without it; web search is disabled with a friendly message when unset.
# TAVILY_API_KEY=tvly-your-key-here

# Optional: observability. Set both keys to send traces to Langfuse
# (https://langfuse.com). Tracing is off when unset.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com   # or your self-hosted URL

# Models
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
CHAT_TEMPERATURE=0.3

# Storage (single SQLite file holds chat log + memories + checkpoints)
MEMORY_DB_PATH=chat_memory.db

# Memory tuning
SHORT_TERM_WINDOW=20     # recent messages sent to the model each turn
MEMORY_TOP_K=5           # long-term memories recalled per turn
MEMORY_MIN_SCORE=0.25    # min cosine similarity to count as relevant
