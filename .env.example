# =============================================================
#  AI Agent — configuration
#  Copy this file to `.env` and fill in the values you have.
#  Only OPENAI_API_KEY is required; everything else is optional.
# =============================================================

# ---- Required: powers the agent's reasoning + tool calling ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Optional API keys (tools fall back gracefully if unset) ----
# Calendarific — improves the "festival date" tool. Free tier: https://calendarific.com
CALENDARIFIC_API_KEY=

# NewsAPI — optional alternative source for news headlines. https://newsapi.org
# (Left blank, the news tool uses free Google News RSS instead.)
NEWSAPI_KEY=

# ---- Server / app settings ----
HOST=127.0.0.1
PORT=8765
# Directory where "save research result" writes exported files
EXPORT_DIR=exports
